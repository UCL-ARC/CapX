@using System.Diagnostics
@using Microsoft.EntityFrameworkCore
@using PPMTool.Data.Context
@using PPMTool.Data.Enums
@using PPMTool.Services

<RadzenCard Variant="Variant.Outlined"
            class="ai-chat-card">
    <RadzenStack Orientation="Radzen.Orientation.Vertical"
                 Gap="0.5rem"
                 class="ai-chat-stack">
        <HintComponent Message="The agent runs a local LLM alongside the web application. It has a read-only connection to the database. You can use the agent to ask natural language queries about the data. For example, 'How many projects did we do for the faculty of humanities in 2026?'" />
        <RadzenAIChat UserAvatarText="@avatarText"
                      Placeholder="Ask me anything..."
                      Endpoint="@llmEndpoint"
                      Model="@llmModel"
                      ShowDateSeparator="true"
                      MessageAdded="@OnMessageAdded"
                      MessageSent="@OnMessageSent"
                      ResponseReceived="@OnResponseReceived"
                      ChatCleared="@OnChatCleared"
                      class="ai-chat-window" />
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter]
    public int? ActiveUserId { get; set; }

    [Inject]
    private UserService UserService { get; set; }

    [Inject]
    private IDbContextFactory<PPMToolContext> ContextFactory { get; set; }

    [Inject]
    private SettingsService SettingsService { get; set; }

    [Inject]
    private DatabaseSchemaPromptService DatabaseSchemaPromptService { get; set; }

    [Inject]
    private ILogger<AIChatComponent> Logger { get; set; }

    private string avatarText;
    private string llmEndpoint;
    private string llmModel;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Go get the person from the DB
        if (ActiveUserId.HasValue)
        {
            using (var context = ContextFactory.CreateDbContext())
            {
                var user = UserService.GetById(context, ActiveUserId.Value);
                if (user != null)
                {
                    avatarText = user.GetInitials();
                }
            }
        }
        
        // Get the LLM endpoint from the settings
        llmEndpoint = SettingsService.GetSetting(SettingType.LLMEndPoint);
        Debug.WriteLine($"** LLM Endpoint = '{llmEndpoint}'");

        // Get the LLM model from the settings
        llmModel = SettingsService.GetSetting(SettingType.LLMModel);
        Debug.WriteLine($"** LLM Model = '{llmModel}'");
    }

    void OnMessageAdded(Radzen.Blazor.ChatMessage message)
    {
        Debug.WriteLine($"Message added: {(message.IsUser ? "User" : "Assistant")} - {message.Content.Substring(0, Math.Min(50, message.Content.Length))}...",
                   message.IsUser ? AlertStyle.Info : AlertStyle.Success);
    }

    void OnMessageSent(string message)
    {
        Debug.WriteLine($"Message sent: {message}", AlertStyle.Info);
    }

    void OnResponseReceived(string response)
    {
        Debug.WriteLine($"AI Response received: {response.Substring(0, Math.Min(50, response.Length))}...", AlertStyle.Success);
    }

    void OnChatCleared()
    {
        Debug.WriteLine("Chat cleared", AlertStyle.Warning);
    }
}
